rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return request.auth.token.role; }
    function clinicId() { return request.auth.token.clinicId; }
    function isPlatform() { return signedIn() && role() == 'platform_admin'; }
    function isClinicAdmin(cId) { return signedIn() && (role() == 'clinic_admin' || role() == 'doctor') && clinicId() == cId; }
    function isDoctor() { return signedIn() && role() == 'doctor'; }

    match /public_listings/{listingId} {
      allow read: if true;
      allow write: if isPlatform();
    }

    match /clinics/{cId} {
      allow read: if signedIn();
      allow write: if isPlatform();

      match /clinics_listings/{listingId} {
        allow read: if true;
        allow create, update, delete: if isClinicAdmin(cId) || isPlatform();
      }

      match /or_listings/{listingId} {
        allow read: if true;
        allow create, update, delete: if isClinicAdmin(cId) || isPlatform();
      }

      match /bookings/{bookingId} {
        allow read: if isClinicAdmin(cId) || isPlatform() || (isDoctor() && resource.data.doctorId == request.auth.uid);
        allow create: if isDoctor() && request.resource.data.doctorId == request.auth.uid;
        allow update: if isClinicAdmin(cId) || isPlatform() || (isDoctor() && resource.data.doctorId == request.auth.uid);
        allow delete: if isPlatform();
      }

      match /doctor_access/{doctorId} {
        allow read: if isClinicAdmin(cId) || isPlatform() || (isDoctor() && request.auth.uid == doctorId);
        allow create, update: if isClinicAdmin(cId) || isPlatform() || (isDoctor() && request.auth.uid == doctorId);
        allow delete: if isClinicAdmin(cId) || isPlatform();
      }

      match /verification/{docId} {
        allow read: if isClinicAdmin(cId) || isPlatform();
        allow create, update: if isClinicAdmin(cId) || isPlatform();
        allow delete: if isPlatform();
      }

      match /patients_cipher/{patientCipherId} {
        allow read: if isClinicAdmin(cId) || isPlatform();
        allow create, update: if isClinicAdmin(cId) || isPlatform() || isDoctor();
        allow delete: if isPlatform();
      }

      match /ledger/{entryId} {
        allow read: if isClinicAdmin(cId) || isPlatform();
        allow write: if isPlatform();
      }

      match /crypto/keys/{keyId} {
        allow read, write: if isPlatform();
      }
    }

    match /doctors/{uid} {
      allow read: if isPlatform() || (signedIn() && request.auth.uid == uid);
      allow write: if isPlatform() || (signedIn() && request.auth.uid == uid);

      match /private/{docId} {
        allow read, write: if isPlatform() || (signedIn() && request.auth.uid == uid);
      }

      match /crypto/keys/{keyId} {
        allow read, write: if isPlatform();
      }

      match /verification/{docId} {
        allow read: if isPlatform() || (signedIn() && request.auth.uid == uid);
        allow write: if isPlatform();
      }

      match /reviews/{reviewId} {
        allow read: if isPlatform() || (signedIn() && request.auth.uid == uid);
        allow write: if isPlatform();
      }
    }

    match /webhook_events/{eventId} {
      allow read, write: if isPlatform();
    }
  }
}
